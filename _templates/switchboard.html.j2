{% extends "base.html.j2" %}
{%- from 'partials/macros.j2' import meter_card, diagram_legend -%}
{#- ────────────────────────────────────────────────────────────────────────
    switchboard.html.j2 — a switchboard's single-line diagram, built by
    _build/build_switchboards.py from the meters file and
    data/switchboards.yaml.

    The incomer sits on top, feeding the busbar; the board's ways, every
    meter the incomer feeds, hang below it, `columns` to a busbar row, each
    later row tied back to the first down the left. A bus coupler runs the
    busbar on, through its breaker, to the board it ties to. Every meter is
    a meter_card placeholder that meter-templates.js fills; the busbar and
    the lines are CSS (switchboard-widget.css). The key above the diagram
    reads the cards' colours.

      incomer  : {meter_id, label, rating, ct}
      fed_from : {href, label} | none, the board feeding this one
      ways     : [{meter_id, label, rating, ct, wraps, link?: {href, label}}],
                 wraps: it starts a busbar row; link: the board or riser it feeds
      columns  : ways to a busbar row
      couplers : [{side, open, href, label, meter?}], left and/or right
   ──────────────────────────────────────────────────────────────────────── -#}
{% block extra_styles %}    <link rel="stylesheet" href="{{ _pp }}css/project/2.0/switchboard-widget.css">
{% endblock %}
{% block content %}
                <div class="switchboard-card-no-animation primary">
                    <div class="sld">
{{ diagram_legend(24) }}
                        <div class="sld-diagram" style="--sld-columns: {{ columns }};">
                            <div class="sld-source">
{{ meter_card(incomer, 'incomer', 32) }}
{%- if fed_from %}
                                <a class="swb-tie" href="{{ fed_from.href }}">{{ fed_from.label }}</a>
{%- endif %}
                            </div>
{%- for c in couplers %}
                            <div class="sld-coupler {{ 'sld-coupler-left' if c.side == 'left' else 'sld-coupler-right' }}{% if not c.open %} sld-coupler-closed{% endif %}">
                                <span class="sld-coupler-switch" title="Bus coupler, normally {{ 'open' if c.open else 'closed' }}"></span>
                                <span class="sld-coupler-note">{{ 'N/O' if c.open else 'N/C' }}</span>
                                <a class="swb-tie" href="{{ c.href }}">{{ c.label }}</a>
{%- if c.meter %}
{{ meter_card(c.meter, '', 32) }}
{%- endif %}
                            </div>
{%- endfor %}
                            <ul class="sld-ways">
{%- for w in ways %}
                                <li class="sld-way">{% if w.wraps %}<span class="sld-wrap"></span>{% endif %}
{{ meter_card(w, '', 36) }}
{%- if w.link %}
                                    <a class="swb-tie" href="{{ w.link.href }}">{{ w.link.label }}</a>
{%- endif %}
                                </li>
{%- endfor %}
                            </ul>
                        </div>
                    </div>
                </div>
{% endblock %}
{% block tail_scripts %}    <!-- Build the meter cards from METER_REGISTRY -->
    <script src="{{ _pp }}js/project/2.0/meter-templates.js"></script>
    <!-- Render + live-update the segmented gauges and comms glow -->
    <script src="{{ _pp }}js/project/2.0/switchboard-gauge.js"></script>
{% endblock %}
