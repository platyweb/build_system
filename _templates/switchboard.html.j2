{% extends "base.html.j2" %}
{# Switchboard single-line diagram. Generated by _build/build_switchboards.py
   from METER_REGISTRY + _data/switchboards.yaml. The busbar is a generated
   SVG background; each meter is a live HTML widget overlay. #}
{% block extra_styles %}    <link rel="stylesheet" href="css/project/2.0/diagrams.css">
    <link rel="stylesheet" href="css/project/2.0/switchboard.css">
    <link rel="stylesheet" href="css/project/2.0/switchboard-widget.css">
{% endblock %}
{% block content %}
                <div class="switchboard-card-no-animation primary">
                    <div class="floorplan-viewer">
                        <div class="floorplan-placeholder">
                            <img src="{{ svg_path }}" alt="{{ heading }}" style="display: block;">
{% for b in boxes %}
                            <a href="/meters/MeterDisplay.html?meter.id={{ b.meter_id }}" target="_blank" rel="noopener noreferrer">
                                <div class="data-overlay swb-box{% if b.is_incomer %} swb-incomer{% endif %}" data-position="{{ b.cx }},{{ b.cy }}" style="width: {{ b.w }}px; height: {{ b.h }}px;">
                                    <div class="swb-head"><span class="swb-dot"></span><span class="swb-title" title="{{ b.title }}">{{ b.title }}</span></div>
                                    <div class="swb-valrow">
                                        <span class="swb-value" data-bacnet="{{ b.bacnet }}" data-format="power" data-refresh="10">Loading...</span>
{% if b.ct %}                                        <span class="swb-ct">CT {{ b.ct }}</span>
{% endif %}                                    </div>
                                    <div class="swb-gauge" data-max="{{ b.rating }}"></div>
                                </div>
                            </a>
{% endfor %}
{% if bus_tie %}
                            <a href="{{ bus_tie.href }}">
                                <div class="data-overlay swb-tie swb-tie-{{ bus_tie.side }}" data-position="{{ bus_tie.label_cx }},{{ bus_tie.label_cy }}">{{ bus_tie.label }}</div>
                            </a>
{% endif %}
                        </div>
                    </div>
                </div>
{% endblock %}
{% block tail_scripts %}    <!-- Position the overlays from their data-position attributes -->
    <script src="js/project/2.0/position-handler.js"></script>
    <!-- Render + live-update the segmented gauges -->
    <script src="js/project/2.0/switchboard-gauge.js"></script>
{% endblock %}
