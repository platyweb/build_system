/**
 * Sidebar Template for {{ tenant_name }}
 * Tenant-specific navigation — generated by _build/build.py
 */

const SIDEBAR_HTML = `
<aside id="sidebar" class="sidebar break-point-lg has-bg-image">
  <a id="btn-collapse" class="sidebar-collapser"><i class="bx bx-md bx-chevron-left"></i></a>
  <div class="image-wrapper">
    <img src="{{ path_prefix }}img/sidebar-bg.png" alt="sidebar background">
  </div>
  <div class="sidebar-layout">
    <a href="{{ 'index.htm' if has_index else '#' }}">
        <div class="sidebar-header">
            <div class="pro-sidebar-logo">
                <div><img src="{{ path_prefix }}img/favicon.png" alt="Optergy"></div>
                <h6><i>{{ building.name }}</i></h6>
            </div>
        </div>
    </a>
    <div class="sidebar-content">
        <nav class="menu open-current-submenu">
            <ul>
                <li class="menu-item" id="theme-toggle-item">
                    <a href="#"
                        onclick="event.preventDefault(); (function(){ var t = document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark'; document.documentElement.setAttribute('data-bs-theme', t); localStorage.setItem('theme', t); document.getElementById('theme-icon').className = t === 'dark' ? 'bx bxs-sun' : 'bx bxs-moon'; document.getElementById('theme-label').textContent = t === 'dark' ? 'Light Mode' : 'Dark Mode'; })();">
                        <span class="menu-icon">
                            <i id="theme-icon" class="bx bxs-moon"></i>
                        </span>
                        <span class="menu-title" id="theme-label">Dark Mode</span>
                    </a>
                </li>
                <li class="menu-header"><span> {{ tenant_name|upper }} </span></li>
                <li class="menu-item sub-menu">
                    <a href="#">
                        <span class="menu-icon">
                            <i class="bx bxs-building"></i>
                        </span>
                        <span class="menu-title">Floor Displays</span>
                    </a>
                    <div class="sub-menu-list">
                        <ul>
{%- if has_index %}
                            <li class="menu-item">
                                <a href="index.htm">
                                    <span class="menu-title">Summary</span>
                                </a>
                            </li>
{%- endif %}
{%- for f in floor_links %}
                            <li class="menu-item">
                                <a href="{{ f.href }}">
                                    <span class="menu-title">{{ f.label }}</span>
                                </a>
                            </li>
{%- endfor %}
                        </ul>
                    </div>
                </li>
                <li class="menu-item">
                    <a href="{{ docs_href }}" target="_blank" rel="noopener">
                        <span class="menu-icon">
                            <i class="bx bxs-file-doc"></i>
                        </span>
                        <span class="menu-title">Docs</span>
                    </a>
                </li>
                <li class="menu-item menu-logout">
                    <a href="/Login.html?logout">
                        <span class="menu-icon">
                            <i class="bx bxs-user"></i>
                        </span>
                        <span class="menu-title">Logout</span>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
    <div class="sidebar-footer">
        <div class="footer-box">
            <div>
                <img class="react-logo" src="{{ path_prefix }}img/knight_logo.svg" alt="KCL">
            </div>
            <div style="padding: 0 10px">
                <a href="mailto:service@knightcontrols.co.uk"><i>service@knightcontrols.co.uk</i></a>
            </div>
        </div>
    </div>
</div>
</aside>

<div id="overlay" class="overlay"></div>
`;

// Apply saved theme immediately
(function() {
  var saved = localStorage.getItem('theme') || 'light';
  document.documentElement.setAttribute('data-bs-theme', saved);
})();

// Auto-inject sidebar when this script loads
(function () {
  'use strict';

  function loadSidebar() {
    const sidebarContainer = document.getElementById('sidebar-container');
    if (!sidebarContainer) {
      console.error('Sidebar container not found.');
      return;
    }
    sidebarContainer.innerHTML = SIDEBAR_HTML;

    var currentTheme = document.documentElement.getAttribute('data-bs-theme') || 'light';
    var themeIcon = document.getElementById('theme-icon');
    var themeLabel = document.getElementById('theme-label');
    if (themeIcon) themeIcon.className = currentTheme === 'dark' ? 'bx bxs-sun' : 'bx bxs-moon';
    if (themeLabel) themeLabel.textContent = currentTheme === 'dark' ? 'Light Mode' : 'Dark Mode';

    requestAnimationFrame(() => {
      const script = document.createElement('script');
      script.src = '{{ path_prefix }}js/project/2.0/sidebar.js';
      script.onload = function () {
        console.log('Sidebar loaded and initialized successfully');
      };
      script.onerror = function () {
        console.error('Failed to load sidebar functionality script');
      };
      document.body.appendChild(script);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadSidebar);
  } else {
    loadSidebar();
  }
})();
