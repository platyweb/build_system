{% extends 'base.html.j2' %}
{%- from 'partials/macros.j2' import floor_summary_card, floorplan_right, floorplan_top, riser_grid_open, riser_card, report_tab_panel -%}

{#- ────────────────────────────────────────────────────────────────────────
    floor.html.j2 — generic floor page.

    Layout mirrors floor_23rd.htm, the hand-built reference for the current
    design: a Floor Summary section (the site's floor_page.summary_cards —
    e.g. Total Electricity / Tenants / Landlords — beside the floorplan
    image), a Riser Meters section (one column per meter-registry column,
    built from `data-floor-meter` auto-widgets), and the site's report tabs
    (floor_page.tabs, rendered by report_tab_panel).

    `floorplan_tab.layout` is an ordered list of column descriptors driven by
    the meter registry (see `derive_layout` in build.py):
        - { type: cards, cards: [ { title, location, meters: [...] }, ... ] }
    One entry per populated column. A column whose first card is the site's
    floor_page.centre_zone (e.g. the landlord/mechanical riser's zone)
    renders with the "top card" styling; zone titles get floor_page.zone_suffix.

    The page's layout (site.yaml floor_page, or the level's own; see
    FLOOR_LAYOUT in build.py) arrives resolved on `floorplan_tab`:
        floorplan      : right | top | none — where the floorplan image goes
        columns        : the riser grid's width (meter_columns, auto resolved)
        summary_layout : split | row — the summary cards in two rows or one
    Their defaults (right, 3, split) write the page as it always was.
   ──────────────────────────────────────────────────────────────────────── -#}

{% block content %}{{ slot('top') }}
                    <!-- Tab Buttons -->
                    <div class="tab-buttons" role="tablist" aria-label="Floor overview sections">
{%- for tab in tabs %}
                        <button class="tab-button{% if loop.first %} active{% endif %}" role="tab" type="button" id="tab-{{ tab.id }}"
                            aria-selected="{{ 'true' if loop.first else 'false' }}" aria-controls="{{ tab.id }}-tab"
                            onclick="switchTab('{{ tab.id }}')">
                            {{ tab.label }}
                        </button>
{%- endfor %}
                    </div>

                    <!-- Floorplan Tab Content -->
                    <div id="floorplan-tab" class="tab-content active" role="tabpanel"
                        aria-labelledby="tab-floorplan" tabindex="0">
{%- set plan = floorplan_tab.floorplan %}
{%- set has_total = floorplan_tab.total_card is defined %}
{%- set has_pair = floorplan_tab.tenants_card is defined or floorplan_tab.landlords_card is defined %}
{%- if plan != 'none' or has_total or has_pair %}
                        <!-- Section 1: Floor Summary -->
                        <div class="floor-section floor-section-summary">
                            <div class="floor-summary-section">
{%- if plan == 'top' %}
{{ floorplan_top(floorplan_tab.image) }}
{%- endif %}
{%- if floorplan_tab.summary_layout == 'row' %}
                                <!-- Floor summary cards in one row{{ ' + Floorplan image' if plan == 'right' else '' }} -->
                                <div class="floor-summary-row">
{%- if has_total or has_pair %}
                                    <div class="floor-summary-dual-block{{ '' if plan == 'right' else ' w-100' }}">
{%- for key in ('total_card', 'tenants_card', 'landlords_card') if floorplan_tab[key] is defined %}
{{ floor_summary_card(dict(floorplan_tab[key], wrapper_class='floor-card')) }}
{%- endfor %}
                                    </div>
{%- endif %}
{%- if plan == 'right' %}
{{ floorplan_right(floorplan_tab.image) }}
{%- endif %}
                                </div>
{%- else %}
{%- if has_total or plan == 'right' %}
                                <!-- Line 1: Total Electricity block{{ ' + Floorplan image' if plan == 'right' else '' }} -->
                                <div class="floor-summary-row">
{%- if has_total %}

{{ floor_summary_card(floorplan_tab.total_card) }}
{%- endif %}
{%- if plan == 'right' %}

{{ floorplan_right(floorplan_tab.image) }}
{%- endif %}
                                </div>
{%- endif %}
{%- if has_pair %}

                                <!-- Line 2: Floor Tenants Electricity & Floor Landlords Electricity -->
                                <div class="floor-summary-row">

                                    <div class="floor-summary-dual-block">
{%- if floorplan_tab.tenants_card is defined %}
{{ floor_summary_card(floorplan_tab.tenants_card) }}
{%- endif %}
{%- if floorplan_tab.landlords_card is defined %}

{{ floor_summary_card(floorplan_tab.landlords_card) }}
{%- endif %}
                                    </div>
                                </div>
{%- endif %}
{%- endif %}
                            </div>
                        </div>
{%- endif %}{{ slot('after_summary') }}

                        <!-- Section 2: Riser Meters -->
                        <div class="floor-section floor-section-risers">
                            <div class="floor-summary-subtitle">Physical Riser Meters</div>
{{ riser_grid_open(floorplan_tab.columns) }}
{%- for col in floorplan_tab.layout if col.type == 'cards' %}
{%- set is_center = col.cards and col.cards[0].title == floor_page.centre_zone %}
                                <div class="{{ 'center-column' if is_center else 'riser-column' }}">
{%- for card in col.cards %}
{%- set suffix = floor_page.zone_suffix.centre if card.title == floor_page.centre_zone else floor_page.zone_suffix.side %}

{{ riser_card({'title': card.title ~ suffix, 'location': card.location, 'meters': card.meters, 'header_link': card.header_link}, 'center' if is_center else 'side') }}
{%- endfor %}
                                </div>
{%- endfor %}
                            </div>
                        </div>{{ slot('after_risers') }}
                    </div>
{%- for tab in report_tabs %}

{{ report_tab_panel(tab) }}
{%- endfor %}{{ slot('bottom') }}
{% endblock %}

{% block extra_scripts %}
    <!-- Load position handler for data-position attributes -->
    <script src="{{ _pp }}js/project/2.0/position-handler.js"></script>
{%- endblock %}

{% block tail_scripts %}
    <!-- Load floor tab switching and meter styling -->
    <script src="{{ _pp }}js/project/2.0/floor-tabs.js"></script>
    <!-- Load meter templating -->
    <script src="{{ _pp }}js/project/2.0/meter-templates.js"></script>
{%- endblock %}
