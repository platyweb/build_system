{#- ────────────────────────────────────────────────────────────────────────
    Reusable building blocks shared by floor/incomer/etc. page templates.
    All macros assume an indentation context of ~32 leading spaces (i.e. they
    are emitted inside the .tab-content / .summary-cards / .page-layout-grid
    blocks of a page). Indentation is intentional to mirror the existing
    hand-written HTML so diffs stay reviewable.
   ──────────────────────────────────────────────────────────────────────── -#}

{# ── summary_card: title + value (static text OR live BACnet OR meter binding) ── #}
{%- macro summary_card(card) %}                            <div class="summary-card">
                                <div class="summary-card-title">{{ card.title }}</div>
                                <div class="summary-card-value">
{%- if card.value is defined -%}
{{ card.value }}
{%- elif card.meter_id is defined %}
                                    <div data-meter-id="{{ card.meter_id }}" data-meter-field="{{ card.meter_field }}" data-refresh="{{ card.refresh|default(10) }}">Loading...</div>
{%- else %}
                                    <div{% if card.id|default(false) %} id="{{ card.id }}"{% endif %} class="info-item-value"
                                        data-bacnet="{{ card.bacnet }}" data-format="{{ card.format }}"{% if card.decimal_places is defined %} data-decimal-places="{{ card.decimal_places }}"{% endif %} data-refresh="{{ card.refresh|default(10) }}">
                                        Loading...
                                    </div>
{%- endif %}
                                </div>
                            </div>
{%- endmacro %}


{# ── meter_stats_group: one stats block inside a floor-card ─────────────── #}
{%- macro meter_stats_group(m, field_labels) -%}
{%- set fields_to_show = m.fields|default(['demand', 'daily', 'monthly']) -%}
{%- set link_target = m.link|default('/meters/MeterDisplay.html?meter.id=' ~ m.id) %}
                                    <a href="{{ link_target }}" target="_blank"
                                        rel="noopener noreferrer" class="floor-stats-group-link">
                                        <div class="floor-stats-group">
                                            <div class="floor-stats-subheader{% if m.utility %} meter-{{ m.utility }}{% endif %} floor-stats-subheader-flex">
                                                <span>{{ m.label }}</span>
                                                <div data-meter-id="{{ m.id }}" data-meter-field="status" data-refresh="10">
                                                    Loading...</div>
                                            </div>
                                            <div class="floor-stats floor-stats-flex">
{%- for field in fields_to_show %}
                                                <div class="stat-box stat-box-flex">
                                                    <span class="stat-label">{{ field_labels[field] }}</span>
                                                    <span class="stat-value">
                                                        <div data-meter-id="{{ m.id }}" data-meter-field="{{ field }}"
                                                            data-refresh="10">Loading...</div>
                                                    </span>
                                                </div>
{%- endfor %}
                                            </div>
                                        </div>
                                    </a>
{%- endmacro %}


{# ── floor_summary_card: Total/Tenants/Landlords card in floor-section-summary ── #}
{# Live when `card.meter_id` resolves from METER_REGISTRY (see                  #}
{# find_floor_summary_meter/derive_floor_summary_cards in build.py — keyed by   #}
{# (floor, function) with function one of "Floor Total Electricity"/"Floor      #}
{# Tenants Electricity"/"Floor Landlords Electricity"); a static "N/A"          #}
{# placeholder otherwise, so a floor never links to the wrong meter before its  #}
{# registry row exists.                                                        #}
{%- macro floor_summary_card(card) %}
{%- set has_meter = card.meter_id is defined and card.meter_id is not none %}
                                    <div class="{{ card.wrapper_class|default('floor-card') }}">
{%- if has_meter %}
                                        <a href="/meters/MeterDisplay.html?meter.id={{ card.meter_id }}" target="_blank"
                                            rel="noopener noreferrer" class="floor-header-link">
{%- endif %}
                                            <div class="floor-header">
                                                <div class="floor-info">
                                                    <div class="floor-title">{{ card.title }}</div>
                                                    <div class="floor-location">{{ card.location|default('Calculated') }}</div>
                                                </div>
                                            </div>
{%- if has_meter %}
                                            <div class="floor-stats-group">
                                                <div data-floor-stats="{{ card.meter_id }}"></div>
                                            </div>
                                        </a>
{%- else %}
                                        <div class="floor-stats-group">
                                            <div class="floor-stats floor-stats-flex">
                                                <div class="stat-box stat-box-flex">
                                                    <span class="stat-label">Demand:</span>
                                                    <span class="stat-value">N/A</span>
                                                </div>
                                                <div class="stat-box stat-box-flex">
                                                    <span class="stat-label">Current Month:</span>
                                                    <span class="stat-value">N/A</span>
                                                </div>
                                                <div class="stat-box stat-box-flex">
                                                    <span class="stat-label">Previous Month:</span>
                                                    <span class="stat-value">N/A</span>
                                                </div>
                                            </div>
                                        </div>
{%- endif %}
                                    </div>
{%- endmacro %}


{# ── The floorplan image on a floor / tenant-floor page (floor_page.floorplan) ── #}
{# floorplan_right: beside the summary cards, in their first row (hidden on    #}
{# narrow screens); floorplan_top: above them, full width.                    #}
{%- macro floorplan_right(image) %}                                    <div class="floor-summary-image">
                                        <img src="{{ image }}" alt="Floor Plan" class="floor-summary-img">
                                    </div>
{%- endmacro %}

{%- macro floorplan_top(image) %}                                <!-- Floorplan image -->
                                <div class="text-center">
                                    <img src="{{ image }}" alt="Floor Plan" class="floor-summary-plan-img img-fluid rounded">
                                </div>
{%- endmacro %}


{# ── riser_grid_open: the riser grid's opening tag (close it with </div>) ── #}
{# `columns` is the page's resolved floor_page.meter_columns; the grid has 3  #}
{# columns, and floor-grid-cols-<n> (style.css) gives it any other count.     #}
{%- macro riser_grid_open(columns) %}
{%- if columns == 3 %}                            <!-- 3 Column Layout: Left | Center (top card) | Right -->
                            <div class="floor-three-column-grid">
{%- else %}                            <!-- {{ columns }} Column Layout -->
                            <div class="floor-three-column-grid floor-grid-cols-{{ columns }}">
{%- endif %}
{%- endmacro %}


{# ── riser_card: zone card built from data-floor-meter auto-widgets ────── #}
{# Lighter-weight sibling of floor_card: each meter is a single              #}
{# `data-floor-meter` placeholder that meter-templates.js expands client-    #}
{# side into the full stats row, instead of the server-rendered stat spans   #}
{# floor_card emits. variant="center" (the North/landlord riser) wraps the   #}
{# meters in one .floor-stats-group and gets the "top card" class; the       #}
{# default "side" variant (East/West tenant risers) lists them flat.        #}
{%- macro riser_card(card, variant='side') %}
{%- set link = card.header_link|default(floor_page.riser_card_link) %}
                                <div class="{{ 'riser-column-top-card floor-card' if variant == 'center' else 'floor-card' }}">
                                    <a href="{{ link }}"{% if link != '#' %} target="_blank" rel="noopener noreferrer"{% endif %}
                                        class="floor-header-link">
                                        <div class="floor-header">
                                            <div class="floor-info">
                                                <div class="floor-title">{{ card.title }}</div>
                                                <div class="floor-location">{{ card.location }}</div>
                                            </div>
                                        </div>
                                    </a>
{%- if variant == 'center' %}
                                    <div class="floor-stats-group">
{%- for m in card.meters %}
                                        <div data-floor-meter="{{ m.id }}"></div>
{%- endfor %}
                                    </div>
{%- else %}
{%- for m in card.meters %}

                                    <div data-floor-meter="{{ m.id }}"></div>
{%- endfor %}
{%- endif %}
                                </div>
{%- endmacro %}


{# ── report_tab_panel: one report tab on a floor / tenant-floor page ─────── #}
{# `tab` is a build.py report tab: {id, label, summary_cards, reports} (from  #}
{# site.yaml floor_page.tabs). with_cards=false drops the summary-card strip  #}
{# (tenant floor pages show reports only).                                    #}
{%- macro report_tab_panel(tab, with_cards=true) %}                    <!-- {{ tab.label }} Tab Content -->
                    <div id="{{ tab.id }}-tab" class="tab-content" role="tabpanel"
                        aria-labelledby="tab-{{ tab.id }}" tabindex="0">
{%- if with_cards %}
                        <div class="summary-cards">
{%- for card in tab.summary_cards %}
{{ summary_card(card) }}
{%- endfor %}
                        </div>
{%- endif %}
{%- for report in tab.reports %}
{{ report_card(report) }}
{%- endfor %}
                    </div>
{%- endmacro %}


{# ── floor_card: header (zone/riser) + N stats groups ──────────────────── #}
{# header_link="#" suppresses target/rel (matches tenant-page convention).  #}
{%- macro floor_card(card, field_labels) %}
{%- if card.comment is defined %}
                                <!-- {{ card.comment }} -->
{%- endif %}
{%- set link = card.header_link|default(floor_page.riser_card_link) %}
                                <div class="floor-card">
                                    <a href="{{ link }}"{% if link != '#' %} target="_blank" rel="noopener noreferrer"{% endif %}
                                        class="floor-header-link">
                                        <div class="floor-header">
                                            <div class="floor-info">
                                                <div class="floor-title">{{ card.title }}</div>
                                                <div class="floor-location">{{ card.location }}</div>
                                            </div>
                                        </div>
                                    </a>
{%- for m in card.meters %}

{{ meter_stats_group(m, field_labels) }}
{%- endfor %}
                                </div>
{%- endmacro %}


{# ── meter_node: one <li> in the meters_hierarchy tree, recursive ─────── #}
{# Type "Calculation" renders as Virtual / .meter-virtual; everything else #}
{# (Modbus / Bacnet) renders as Physical / .meter-electrical. Status and  #}
{# demand addresses come from site.yaml `bacnet:` (bacnet_address /         #}
{# demand_address globals, see build.py). The utility class stacks on      #}
{# top of that and carries its own virtual marker — a utility of           #}
{# "lthw-virtual" gives .meter-lthw-virtual, which wins over .meter-virtual #}
{# on source order and keeps the LTHW colours with a purple right edge.    #}
{%- macro meter_node(m, children_map, depth=0) -%}
{%- set ind = ' ' * (32 + 4 * depth) -%}
{%- set has_children = children_map.get(m.id) -%}
{%- set is_virtual = m.type == 'Calculation' -%}
{{ ind }}<li{% if not has_children %} class="no-children"{% endif %}>
{{ ind }}    <span class="toggle-btn" onclick="toggleChildren(this)"></span>
{{ ind }}    <a href="/meters/MeterDisplay.html?meter.id={{ m.id }}" target="_blank" rel="noopener noreferrer" class="meter meter-{{ 'virtual' if is_virtual else 'electrical' }}{% if m.utility %} meter-{{ m.utility }}{% endif %}">
{{ ind }}        <div class="meter-info">
{{ ind }}            <span class="meter-id">{{ m.tag }}</span>
{{ ind }}            <span class="meter-type">{{ 'Virtual' if is_virtual else 'Physical' }}</span>
{{ ind }}            <span class="meter-status">
{{ ind }}                <div id="live-status-{{ m.id }}" class="info-item-value"
{{ ind }}                    data-bacnet="{{ bacnet_address(3, m.base) }}" data-format="status"
{{ ind }}                    data-refresh="10" data-status-online-svg="img/online-indicator.svg"
{{ ind }}                    data-status-offline-svg="img/offline-indicator.svg"
{{ ind }}                    data-status-online-text=" " data-status-offline-text=" "
{{ ind }}                    style="font-size: 12px;"></div>
{{ ind }}            </span>
{{ ind }}            <span class="meter-load">
{{ ind }}                <div id="live-power-{{ m.id }}" class="info-item-value-small"
{{ ind }}                    data-bacnet="{{ demand_address(m) }}" data-format="power"
{{ ind }}                    data-refresh="10">Loading...</div>
{{ ind }}            </span>
{{ ind }}        </div>
{{ ind }}    </a>
{%- if has_children %}
{{ ind }}    <ul>
{%- for child in has_children %}
{{ meter_node(child, children_map, depth + 1) }}
{%- endfor %}
{{ ind }}    </ul>
{%- endif %}
{{ ind }}</li>
{%- endmacro %}


{# ── info_bar_item: one tile in the home page's top KPI strip ─────────── #}
{# Used by home.html.j2. Each tile is an anchor wrapping an info-item with #}
{# a label and either a live BACnet binding or a static value.            #}
{%- macro info_bar_item(item) %}                        <a href="{{ item.link }}" target="_blank" rel="noopener noreferrer"
                            class="floor-header-link">
                            <div class="info-item">
                                <div class="info-item-label">{{ item.label }}</div>
{%- if item.value is defined %}
                                <div class="info-item-value">{{ item.value }}</div>
{%- else %}
                                <div id="{{ item.id }}" class="info-item-value" data-bacnet="{{ item.bacnet }}"
                                    data-format="{{ item.format }}" data-refresh="{{ item.refresh|default(10) }}">Loading...</div>
{%- endif %}
                            </div>
                        </a>
{%- endmacro %}


{# ── live_dial: a segmented gauge bound to a live BACnet point ───────────── #}
{# Rendered by js/project/2.0/energy-dials.js (needs d3 + energy-charts.js +  #}
{# dials.css). `d` fields: bacnet (required), label, format (power→kW), min,  #}
{# max, suffix, decimals, refresh, width, height. Container uses              #}
{# data-dial-bacnet so the generic live-points binder leaves it alone.        #}
{%- macro live_dial(d) %}                        <div class="dial-card">
                            <div class="energy-dial"
                                data-dial-bacnet="{{ d.bacnet }}"
{%- if d.format|default(false) %} data-format="{{ d.format }}"{% endif %}
                                data-label="{{ d.label|default('') }}"
                                data-min="{{ d.min|default(0) }}" data-max="{{ d.max|default(100) }}"
{%- if d.suffix is defined %} data-suffix="{{ d.suffix }}"{% endif %}
{%- if d.decimals is defined %} data-decimals="{{ d.decimals }}"{% endif %}
{%- if d.width|default(false) %} data-width="{{ d.width }}"{% endif %}
{%- if d.height|default(false) %} data-height="{{ d.height }}"{% endif %}
                                data-refresh="{{ d.refresh|default(10) }}"></div>
                        </div>
{%- endmacro %}


{# ── mini_stat_card: slim floor-card with header + N stat-boxes ───────── #}
{# Used by stat_grids on incomer_electricity. Each stat-box renders an     #}
{# info-item-value-small binding (vs. summary_card's info-item-value).     #}
{%- macro mini_stat_card(card) %}
{%- if card.comment is defined %}
                            <!-- {{ card.comment }} -->
{%- endif %}
{%- set link = card.link|default('#') %}
                            <a href="{{ link }}"{% if link != '#' %} target="_blank" rel="noopener noreferrer"{% endif %} class="floor-card">
                                <div class="floor-header">
                                    <div class="floor-info">
                                        <div class="floor-title">{{ card.title }}</div>
{%- if card.location is defined %}
                                        <div class="floor-location">{{ card.location }}</div>
{%- endif %}
                                    </div>
                                </div>
                                <div class="floor-stats">
{%- for s in card.stats %}
                                    <div class="stat-box">
                                        <div class="stat-label">{{ s.label }}</div>
                                        <div class="stat-value">
{%- if s.wrap_span|default(false) %}
                                            <span>
                                                <div id="{{ s.id }}" class="info-item-value-small"
                                                    data-bacnet="{{ s.bacnet }}" data-format="{{ s.format }}"{% if s.decimal_places is defined %} data-decimal-places="{{ s.decimal_places }}"{% endif %} data-refresh="{{ s.refresh|default(10) }}">
                                                    Loading...</div>
                                            </span>
{%- else %}
                                            <div id="{{ s.id }}" class="info-item-value-small"
                                                data-bacnet="{{ s.bacnet }}" data-format="{{ s.format }}"{% if s.decimal_places is defined %} data-decimal-places="{{ s.decimal_places }}"{% endif %} data-refresh="{{ s.refresh|default(10) }}">
                                                Loading...</div>
{%- endif %}
                                        </div>
                                    </div>
{%- endfor %}
                                </div>
                            </a>
{%- endmacro %}


{# ── report_card: a report card, by name ───────────────────────────────── #}
{# reports.js builds the card on load: its chart from ReportUrls.reports,  #}
{# and the rest from REPORT_CARDS, which the build writes from reports.yaml #}
{# placements: the style (plain; headed on home; titled on building        #}
{# performance; a placement's `kind` overrides), title, subtitle, alt text #}
{# and report-library link (#, without an id).                             #}
{%- macro report_card(report, indent=24) %}{{ ' ' * indent }}<div data-report="{{ report.image_ref.removeprefix('reports.') }}"></div>
{%- endmacro %}


{# The card's style is in REPORT_CARDS now; these names stay for a site    #}
{# template that still imports them.                                       #}
{%- macro report_card_headed(report, indent=24) %}{{ report_card(report, indent) }}{%- endmacro %}
{%- macro report_card_titled(report, indent=28) %}{{ report_card(report, indent) }}{%- endmacro %}


{# ── floorplan_viewer: centre image in the layout ──────────────────────── #}
{%- macro floorplan_viewer(image) %}                            <!-- CENTER COLUMN: Floorplan Image -->
                            <div class="floorplan-viewer floorplan-viewer-constrained">
                                <div class="floorplan-placeholder">
                                    <img src="{{ image }}" alt="Floorplan" class="floorplan-image">
                                </div>
                            </div>
{%- endmacro %}


{# ── Schematic overlay macros (used by schematic.html.j2) ─────────────────  #}
{# All four shapes share `position` and emit `<div class="data-overlay">`     #}
{# at native SVG-aligned pixel coordinates. data-position is handled by       #}
{# js/project/2.0/position-handler.js at runtime.                              #}

{# Shape 1: link zone — clickable rectangle, no live data ──────────────── #}
{%- macro data_overlay_link(o) %}                                <a href="{{ o.link }}" target="_blank" rel="noopener noreferrer"><div class="data-overlay" data-position="{{ o.position }}"{% if o.width|default(false) or o.height|default(false) %}  style="{% if o.width|default(false) %}width: {{ o.width }}px;{% endif %}{% if o.height|default(false) %} height: {{ o.height }}px;{% endif %}"{% endif %}></div></a>
{%- endmacro %}


{# Shape 2: meter overlay — live data bound via data-meter-id ─────────── #}
{# Runtime (meter-templates.js) fills data-bacnet + data-format from the    #}
{# meter's registry entry. The default field is `demand` (current power).   #}
{%- macro data_overlay_meter(o) -%}
{%- set field = o.field|default('demand') %}
                                <a href="/meters/MeterDisplay.html?meter.id={{ o.meter_id }}" target="_blank"
                                    rel="noopener noreferrer">
                                    <div{% if o.id|default(false) %} id="{{ o.id }}"{% endif %} class="info-item-value data-overlay power loading"
                                        data-position="{{ o.position }}" data-meter-id="{{ o.meter_id }}" data-meter-field="{{ field }}"
                                        data-refresh="{{ o.refresh|default(10) }}">Loading...</div>
                                </a>
{%- endmacro %}


{# Shape 3: status indicator paired with a meter ──────────────────────── #}
{%- macro data_overlay_status(o) -%}
{%- set size = o.font_size|default(10) %}
{%- if o.meter_id is defined %}
                                <div{% if o.id|default(false) %} id="{{ o.id }}"{% endif %} class="info-item-value data-overlay text-{{ size }}"
                                    data-position="{{ o.position }}" data-meter-id="{{ o.meter_id }}" data-meter-field="status"
                                    data-refresh="{{ o.refresh|default(10) }}"></div>
{%- else %}
                                <div{% if o.id|default(false) %} id="{{ o.id }}"{% endif %} class="info-item-value data-overlay text-{{ size }}"
                                    data-position="{{ o.position }}" data-bacnet="{{ o.bacnet }}" data-format="status"
                                    data-refresh="{{ o.refresh|default(10) }}"
                                    data-status-online-svg="img/online-indicator.svg"
                                    data-status-offline-svg="img/offline-indicator.svg"
                                    data-status-online-text=" " data-status-offline-text=" "></div>
{%- endif %}
{%- endmacro %}


{# Shape 4: raw overlay — explicit BACnet (tariff / aggregate points) ── #}
{# Optional `link` wraps in <a href=...>; otherwise emits href="#".       #}
{# context_menu + override_hash support editable tariff values.           #}
{%- macro data_overlay_raw(o) -%}
{%- set href = o.link|default('#') -%}
{%- set is_meter_link = href != '#' -%}
{%- set styling = ' power' if o.format in ('power', 'energy', 'water') else '' -%}
                                <a href="{{ href }}"{% if is_meter_link %} target="_blank"
                                    rel="noopener noreferrer"{% endif %}>
                                    <div{% if o.id|default(false) %} id="{{ o.id }}"{% endif %} class="info-item-value data-overlay{{ styling }} loading"
                                        data-position="{{ o.position }}" data-bacnet="{{ o.bacnet }}" data-format="{{ o.format }}"
                                        data-refresh="{{ o.refresh|default(10) }}"
                                        {%- if o.context_menu is defined %} data-context-menu="{{ o.context_menu }}"{% endif %}
                                        {%- if o.override_hash is defined %} data-override-hash="{{ o.override_hash }}"{% endif %}>{{ o.text|default('Loading...') }}</div>
                                </a>
{%- endmacro %}


{# Dispatch: one overlay record → the right shape based on `kind`. #}
{%- macro schematic_overlay(o) -%}
{%- if o.kind == 'link' %}{{ data_overlay_link(o) }}
{%- elif o.kind == 'status' %}{{ data_overlay_status(o) }}
{%- elif o.kind == 'raw' %}{{ data_overlay_raw(o) }}
{%- else %}{{ data_overlay_meter(o) }}
{%- endif %}
{%- endmacro %}
