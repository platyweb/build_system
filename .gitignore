# Virtual environments - never commit these
.venv/
venv/
env/
ENV/
.python-version

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Node
node_modules/

# Editor / OS
.DS_Store
*.swp
.idea/

# Generated report artifacts (PDFs, PNGs, rendered HTML) - regenerate locally.
# Anchored to the repo root: an unanchored `project/` also matched
# _assets/css/project/ and _assets/js/project/, silently dropping the runtime
# skeleton's own CSS/JS from git.
/project/

# Full copy of the last golden build, kept locally for readable diffs
# (_build/regress.py). The committed sha256 manifests are the regression bar.
/_baseline/
